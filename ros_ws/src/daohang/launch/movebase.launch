<launch>
    <node pkg="move_base" type="move_base" name="move_base" output="screen" respawn="false" clear_params="true">
        <rosparam file="$(find daohang)/param/costmap_common_params.yaml" command="load" ns="global_costmap" />
        <rosparam file="$(find daohang)/param/costmap_common_params.yaml" command="load" ns="local_costmap" />
        <rosparam file="$(find daohang)/param/local_costmap_params.yaml" command="load" />
        <rosparam file="$(find daohang)/param/global_costmap_params.yaml" command="load" />
        <rosparam file="$(find daohang)/param/base_local_planner_params.yaml" command="load" />
    </node>
</launch>  
